{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "first_name": {
      "type": "string",
      "description": "The user's first name, shown to other users"
    },
    "last_name": {
      "type": "string",
      "description": "The user's last name, shown to other users"
    },
    "provider_name": {
      "type": "string",
      "description": "The original name from the OAuth provider (Google/Apple) captured at signup \u2014 visible to admins only"
    },
    "username": {
      "type": "string",
      "description": "A unique handle shown to other users"
    },
    "avatar": {
      "type": "string",
      "description": "URL of the user's profile picture"
    },
    "intent": {
      "type": "string",
      "description": "Whether the user is here to buy, sell, or both",
      "enum": [
        "buy",
        "sell",
        "both"
      ]
    },
    "age_range": {
      "type": "string",
      "description": "Self-reported age band collected at signup for admin demographics",
      "enum": [
        "under_16",
        "16_19",
        "20_29",
        "30_39",
        "40_49",
        "50_plus"
      ]
    },
    "gender": {
      "type": "string",
      "description": "Self-reported gender collected at signup for admin demographics",
      "enum": [
        "male",
        "female"
      ]
    },
    "phone": {
      "type": "string",
      "description": "The user's phone number (digits only) \u2014 also serves as the broker contact phone shown on REGA-compliant real estate ads"
    },
    "country_code": {
      "type": "string",
      "description": "The country code prefix for the user's phone number (e.g. +966)"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user's phone number was confirmed via OTP (e.g. during a verification request)"
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user allows direct WhatsApp contact from buyers"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number in international format (digits only, e.g. 9665XXXXXXXX)"
    },
    "whatsapp_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the WhatsApp number was confirmed via OTP"
    },
    "is_trusted": {
      "type": "boolean",
      "default": false,
      "description": "Admin-granted trusted badge \u2014 shown as a verified checkmark to other users"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user is blocked from the app (cannot create listings, chat, or make offers)"
    },
    "banned_reason": {
      "type": "string",
      "description": "Optional reason recorded when a user is banned"
    },
    "followers_override": {
      "type": "number",
      "description": "Optional admin-set floor for the displayed follower count (used when higher than the real follow-record count)"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the user was active in the app (updated throttled on app load)"
    },
    "re_license_type": {
      "type": "string",
      "enum": [
        "individual_fal",
        "establishment_fal"
      ],
      "description": "Type of REGA Fal broker license the user holds (individual or establishment). Filled once in profile settings, reviewed by admin. Ad licenses are per-listing (stored on Item), not per-broker."
    },
    "re_license_number": {
      "type": "string",
      "description": "REGA Fal license number \u2014 filled once in profile settings"
    },
    "re_license_holder": {
      "type": "string",
      "description": "Name of the license holder (broker name) exactly as it appears on the REGA Fal license"
    },
    "re_license_expiry": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the REGA Fal license. The daily archive workflow auto-moves approved brokers to 'expired' status once this date passes."
    },
    "re_license_doc": {
      "type": "string",
      "description": "URL of the uploaded Fal license document (image or PDF)"
    },
    "re_license_phone": {
      "type": "string",
      "description": "Phone number verified against the broker's Fal license (E.164). Either the user's verified account phone (option 1) or a separate number verified via OTP at license submission (option 2). Shown to admins for cross-referencing against the license document and REGA inquiry."
    },
    "re_national_id": {
      "type": "string",
      "description": "National ID (Iqama/National ID) of an individual broker \u2014 pre-filled from the user's approved verification request, editable. Required for individual_fal brokers; empty for establishment brokers. Shown to admins for cross-referencing against the license document."
    },
    "re_establishment_number": {
      "type": "string",
      "description": "Unified establishment number (\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0644\u0644\u0645\u0646\u0634\u0623\u0629) \u2014 required for establishment brokers only; individual brokers leave this empty"
    },
    "re_license_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "description": "Admin review status of the user's real estate Fal license. Only 'approved' users can post Saudi real estate listings. 'expired' is set automatically by the daily workflow when the Fal license expiry date passes; the broker must resubmit to regain posting privileges."
    },
    "re_license_review_reason": {
      "type": "string",
      "description": "Admin's rejection or revocation reason when re_license_status is 'rejected'"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}