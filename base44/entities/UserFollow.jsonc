{
  "name": "UserFollow",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "follower_id": {
      "type": "string",
      "description": "The user who follows"
    },
    "followed_id": {
      "type": "string",
      "description": "The user being followed"
    }
  },
  "required": [
    "follower_id",
    "followed_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}