{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick attribute tags selected by the seller, relevant to the item's category"
    },
    "specs": {
      "type": "object",
      "description": "Structured per-category attributes (e.g. car year/make/mileage, real-estate beds/area, electronics brand/model)"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "city": {
      "type": "string"
    },
    "location_name": {
      "type": "string",
      "description": "Accurate reverse-geocoded place name for display"
    },
    "country": {
      "type": "string",
      "default": "SA"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "seller_trusted": {
      "type": "boolean",
      "default": false,
      "description": "Denormalized copy of the seller's is_trusted flag, kept in sync on trust changes so the 'verified only' search filter can run server-side without joining the User collection"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "available",
        "sold"
      ],
      "default": "available"
    },
    "sold_to": {
      "type": "string"
    },
    "sold_to_name": {
      "type": "string"
    },
    "is_family": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featured_until": {
      "type": "string",
      "format": "date-time"
    },
    "featured_cross_country": {
      "type": "boolean",
      "default": false
    },
    "admin_sponsored": {
      "type": "boolean",
      "default": false,
      "description": "Admin-promoted listing pinned to the top of the Home feed regardless of post date. Set by admins from the Listings tab."
    },
    "admin_sponsored_until": {
      "type": "string",
      "format": "date-time",
      "description": "When the admin sponsorship expires. Items past this date drop back to normal feed ordering."
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "favorites_count": {
      "type": "number",
      "default": 0,
      "description": "Best-effort count of users who saved this listing (incremented on favorite)"
    },
    "willing_to_ship": {
      "type": "boolean",
      "default": false,
      "description": "Seller is willing to ship the item (not just face-to-face)"
    },
    "shipping_fee": {
      "type": "number",
      "description": "Shipping fee in the item's currency (used when willing_to_ship is true)"
    },
    "delivers_within_city": {
      "type": "boolean",
      "default": false,
      "description": "Seller offers delivery within the buyer's city"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Auto-set when the listing hasn't been refreshed in N days, or when its real estate ad license expires; excluded from public feeds until the seller refreshes it"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "approved",
      "description": "Admin moderation status. Real estate listings start as 'approved' when the seller has an approved Fal license (license is verified once at the profile level). All other categories default to 'approved'."
    },
    "review_reason": {
      "type": "string",
      "description": "Admin's rejection reason when review_status is 'rejected'"
    },
    "re_license_type": {
      "type": "string",
      "enum": [
        "individual_fal",
        "establishment_fal"
      ],
      "description": "Copied from the seller's profile \u2014 the broker's Fal license type. Displayed on the ad per REGA content rules."
    },
    "re_license_number": {
      "type": "string",
      "description": "Copied from the seller's profile \u2014 the broker's Fal license number. REGA requires the broker's Fal number to be visible on every real estate ad."
    },
    "re_license_holder": {
      "type": "string",
      "description": "Copied from the seller's profile \u2014 the broker name as it appears on the Fal license. Shown on the ad as the advertiser's name."
    },
    "re_license_expiry": {
      "type": "string",
      "format": "date",
      "description": "Copied from the seller's profile \u2014 the Fal license expiry date."
    },
    "re_license_doc": {
      "type": "string",
      "description": "Copied from the seller's profile \u2014 uploaded Fal license document."
    },
    "re_establishment_number": {
      "type": "string",
      "description": "Copied from the seller's profile \u2014 unified establishment number (for establishment brokers). Empty for individual brokers."
    },
    "re_ad_license_number": {
      "type": "string",
      "description": "Per-listing REGA advertisement license number (\u0631\u0642\u0645 \u0627\u0644\u0625\u0639\u0644\u0627\u0646) \u2014 the publishing permit for this specific property, issued per-ad by REGA."
    },
    "re_ad_license_link": {
      "type": "string",
      "description": "REGA inquiry link for this specific ad license, so buyers and admins can verify in one click."
    },
    "re_ad_license_expiry": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of this listing's ad license. Listings with a past expiry are auto-archived by the daily workflow (REGA requires removal on expiry)."
    },
    "re_deed_area": {
      "type": "string",
      "description": "Property area as stated on the title deed (\u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u062d\u0633\u0628 \u0627\u0644\u0635\u0643) \u2014 required by REGA content rules."
    },
    "re_plan_plot": {
      "type": "string",
      "description": "Land plan and plot number (\u0627\u0644\u0645\u062e\u0637\u0637 \u0648\u0627\u0644\u0642\u0637\u0639\u0629) \u2014 part of the detailed location required by REGA."
    },
    "re_brokerage_contract_number": {
      "type": "string",
      "description": "Brokerage contract reference number (\u0631\u0642\u0645 \u0639\u0642\u062f \u0627\u0644\u0648\u0633\u0627\u0637\u0629) \u2014 the REGA-registered contract between broker and owner; an ad license cannot be issued without one."
    },
    "re_title_deed_number": {
      "type": "string",
      "description": "Title deed number (\u0631\u0642\u0645 \u0635\u0643 \u0627\u0644\u0645\u0644\u0643\u064a\u0629) \u2014 the ownership document for the property."
    },
    "re_title_deed_doc": {
      "type": "string",
      "description": "URL of the uploaded title deed document (\u0635\u0643 \u0627\u0644\u0645\u0644\u0643\u064a\u0629) \u2014 image or PDF."
    },
    "re_has_mortgage": {
      "type": "boolean",
      "default": false,
      "description": "Disclosure of any mortgage or restriction preventing property disposal (\u0627\u0644\u0625\u0641\u0635\u0627\u062d \u0639\u0646 \u0631\u0647\u0646 \u0623\u0648 \u0642\u064a\u062f) \u2014 required by REGA content rules."
    },
    "re_mortgage_details": {
      "type": "string",
      "description": "Details of the mortgage or restriction, if any (\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0631\u0647\u0646 \u0623\u0648 \u0627\u0644\u0642\u064a\u062f)."
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "city"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}