{
  "description": "Sends a reminder notification when a pending offer has been waiting 2+ days without a response",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "offer_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOfferReminders",
            "args": {
              "workflow_secret": "kasir-wf-7f3a9c2e1b8d"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0631\u0633\u0627\u0644 \u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u0639\u0631\u0648\u0636",
            "description": "\u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u0645\u0633\u062a\u0644\u0645\u064a\u0646 \u0627\u0644\u062e\u0627\u0645\u0644\u064a\u0646 \u0628\u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u0645\u0639\u0644\u0642\u0629"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
