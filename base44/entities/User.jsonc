{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "first_name": {
      "type": "string",
      "description": "The user's first name, shown to other users"
    },
    "last_name": {
      "type": "string",
      "description": "The user's last name, shown to other users"
    },
    "username": {
      "type": "string",
      "description": "A unique handle shown to other users"
    },
    "avatar": {
      "type": "string",
      "description": "URL of the user's profile picture"
    },
    "intent": {
      "type": "string",
      "description": "Whether the user is here to buy, sell, or both",
      "enum": [
        "buy",
        "sell",
        "both"
      ]
    },
    "phone": {
      "type": "string",
      "description": "The user's phone number (digits only)"
    },
    "country_code": {
      "type": "string",
      "description": "The country code prefix for the user's phone number (e.g. +966)"
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user allows direct WhatsApp contact from buyers"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number in international format (digits only, e.g. 9665XXXXXXXX)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}