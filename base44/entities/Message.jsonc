{
  "name": "Message",
  "type": "object",
  "properties": {
    "chatroom_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string",
      "description": "The chatroom's buyer \u2014 copied from the room for participant-scoped read access"
    },
    "seller_id": {
      "type": "string",
      "description": "The chatroom's seller \u2014 copied from the room for participant-scoped read access"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ],
      "default": "text"
    },
    "offer_id": {
      "type": "string"
    }
  },
  "required": [
    "chatroom_id",
    "sender_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}