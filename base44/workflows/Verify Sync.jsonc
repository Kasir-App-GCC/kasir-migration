{
  "name": "Verify Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Approves pending verification requests whose Moyasar invoice has been paid \u2014 the reliable backup so verification completes within ~5 minutes even if the client-side confirm call fails.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "verify_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncVerificationPayments"
          },
          "then": "end",
          "x-base44": {
            "title": "\u0645\u0632\u0627\u0645\u0646\u0629 \u0627\u0644\u062a\u0648\u062b\u064a\u0642",
            "description": "Sync pending verification payments"
          }
        }
      }
    ]
  }
}