{
  "name": "Message Push",
  "description": "Sends a native push notification to the other participant whenever a new chat Message is created",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Message",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.sender_id // \"\") != \"system\" and (.trigger.data.kind // \"text\") != \"system\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "message_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushForMessage",
            "args": {
              "secret": "kasir_wf_8d3f2a9c4e1b",
              "chatroom_id": "${ .trigger.data.chatroom_id }",
              "sender_id": "${ .trigger.data.sender_id }",
              "sender_name": "${ .trigger.data.sender_name // \"\" }",
              "text": "${ .trigger.data.text }",
              "kind": "${ .trigger.data.kind // \"text\" }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send message push",
            "description": "Push to the other chat participant"
          }
        }
      }
    ]
  }
}