{
  "description": "Sends a native push notification to the recipient whenever a new Notification record is created",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Notification"
    }
  },
  "name": "Notification Push",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushToUser",
            "args": {
              "user_id": "${ .trigger.data.user_id }",
              "title": "${ .trigger.data.actor_name // \"\" }",
              "content": "${ .trigger.data.text }",
              "item_id": "${ .trigger.data.item_id // \"\" }",
              "chatroom_id": "${ .trigger.data.chatroom_id // \"\" }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send push notification",
            "description": "Push to the notification recipient"
          }
        }
      }
    ]
  }
}