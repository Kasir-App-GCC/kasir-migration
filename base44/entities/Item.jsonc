{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "city": {
      "type": "string"
    },
    "location_name": {
      "type": "string",
      "description": "Accurate reverse-geocoded place name for display"
    },
    "country": {
      "type": "string",
      "default": "SA"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "sold"
      ],
      "default": "available"
    },
    "sold_to": {
      "type": "string"
    },
    "sold_to_name": {
      "type": "string"
    },
    "is_family": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featured_until": {
      "type": "string",
      "format": "date-time"
    },
    "featured_cross_country": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "city"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}