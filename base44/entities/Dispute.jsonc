{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "chatroom_id": {
      "type": "string"
    },
    "complainant_id": {
      "type": "string",
      "description": "The user who opened the dispute"
    },
    "complainant_name": {
      "type": "string"
    },
    "respondent_id": {
      "type": "string",
      "description": "The other party in the transaction"
    },
    "respondent_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "admin_reply": {
      "type": "string",
      "description": "Admin's resolution message"
    }
  },
  "required": [
    "item_id",
    "complainant_id",
    "respondent_id",
    "reason"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.complainant_id": "{{user.id}}"
        },
        {
          "data.respondent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}