{
  "name": "Saved Search Alert",
  "description": "When a new listing is posted, notify buyers who have a saved search matching it",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Item"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "saved_search_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "match_searches": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "matchSavedSearches",
            "args": {
              "item_id": "${ .trigger.entity_id }",
              "workflow_secret": "kasir-wf-7f3a9c2e1b8d"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0628\u062d\u0648\u062b \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629",
            "description": "\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0646 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u064a\u0646 \u0628\u0627\u0644\u0625\u0639\u0644\u0627\u0646 \u0627\u0644\u062c\u062f\u064a\u062f"
          }
        }
      }
    ]
  }
}