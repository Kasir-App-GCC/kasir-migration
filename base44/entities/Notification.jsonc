{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who receives this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "sold",
        "offer_received",
        "offer_accepted",
        "offer_rejected",
        "offer_countered",
        "offer_modified",
        "offer_reminder",
        "verification_submitted",
        "verification_approved",
        "verification_rejected",
        "boost_approved",
        "rate",
        "support_resolved",
        "saved_search_match",
        "new_follower",
        "price_drop",
        "dispute_opened",
        "dispute_resolved",
        "admin_message",
        "listing_approved",
        "listing_rejected",
        "listing_pending_review",
        "re_license_approved_pending_payment",
        "re_license_activated",
        "sponsor_approved_pending_payment",
        "sponsor_rejected",
        "sponsor_activated"
      ],
      "default": "sold"
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "item_image": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "chatroom_id": {
      "type": "string"
    },
    "dispute_id": {
      "type": "string",
      "description": "The dispute this notification refers to (dispute_opened / dispute_resolved type)"
    },
    "offer_amount": {
      "type": "number"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_id": {
      "type": "string",
      "description": "The user id of the actor who triggered this notification (e.g. the follower)"
    },
    "reference_id": {
      "type": "string",
      "description": "Generic reference id (e.g. the SponsorRequest id for sponsor_approved_pending_payment)"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}