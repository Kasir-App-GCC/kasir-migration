{
  "name": "Offer",
  "type": "object",
  "properties": {
    "chatroom_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "countered",
        "completed",
        "not_match"
      ],
      "default": "pending"
    },
    "direction": {
      "type": "string",
      "enum": [
        "buyer_offer",
        "seller_counter"
      ],
      "default": "buyer_offer"
    },
    "previous_offer_id": {
      "type": "string"
    },
    "received_confirmed": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "string",
      "description": "URL of the proposed item picture (used when a seller responds to a Buy Request)"
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last inactivity reminder was sent (prevents duplicate reminders; re-notifies only after a new update)"
    }
  },
  "required": [
    "chatroom_id",
    "item_id",
    "buyer_id",
    "seller_id",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}