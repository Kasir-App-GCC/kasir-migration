{
  "name": "Rating",
  "type": "object",
  "properties": {
    "rated_user_id": {
      "type": "string"
    },
    "rated_user_name": {
      "type": "string"
    },
    "rater_user_id": {
      "type": "string"
    },
    "rater_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "review": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller"
      ]
    }
  },
  "required": [
    "rated_user_id",
    "rater_user_id",
    "score"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.rater_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.rater_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.rater_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}