{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who receives this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "sold",
        "offer_received",
        "offer_accepted",
        "offer_rejected",
        "offer_countered",
        "offer_modified",
        "verification_submitted",
        "verification_approved",
        "verification_rejected",
        "boost_approved",
        "rate",
        "support_resolved"
      ],
      "default": "sold"
    },
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "item_image": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "chatroom_id": {
      "type": "string"
    },
    "offer_amount": {
      "type": "number"
    },
    "actor_name": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}