{
  "name": "Message",
  "type": "object",
  "properties": {
    "chatroom_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string",
      "description": "The chatroom's buyer \u2014 copied from the room for participant-scoped read access"
    },
    "seller_id": {
      "type": "string",
      "description": "The chatroom's seller \u2014 copied from the room for participant-scoped read access"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ],
      "default": "text"
    },
    "offer_id": {
      "type": "string"
    },
    "reactions": {
      "type": "object",
      "description": "Map of emoji -> array of user IDs who reacted with that emoji. e.g. { \"\ud83d\udc4d\": [\"user1\", \"user2\"] }. Kept lightweight \u2014 only stores user IDs, not names."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the message was delivered to the recipient's client (set server-side by markMessagesRead). Drives the 2-gray-check 'delivered' state."
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the recipient actually saw the message (set server-side by markMessagesRead when the bubble scrolls into view). Drives the 2-blue-check 'read' state."
    }
  },
  "required": [
    "chatroom_id",
    "sender_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}