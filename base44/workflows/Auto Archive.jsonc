{
  "name": "Auto Archive",
  "description": "Archives listings not refreshed in 30 days",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_archive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "archive_stale": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveStaleListings"
          },
          "then": "end",
          "x-base44": {
            "title": "\u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629",
            "description": "Archive listings not refreshed in 30 days"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}