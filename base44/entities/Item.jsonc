{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "city": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "sold"
      ],
      "default": "available"
    },
    "sold_to": {
      "type": "string"
    },
    "sold_to_name": {
      "type": "string"
    },
    "is_family": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "city"
  ]
}