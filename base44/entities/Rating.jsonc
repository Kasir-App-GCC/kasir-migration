{
  "name": "Rating",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "rated_user_id": {
      "type": "string"
    },
    "rated_user_name": {
      "type": "string"
    },
    "rater_user_id": {
      "type": "string"
    },
    "rater_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "review": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "offer_id": {
      "type": "string",
      "description": "The accepted offer that triggered this rating (one rating per accepted offer per rater)"
    },
    "role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller"
      ]
    },
    "seller_reply": {
      "type": "string",
      "description": "The rated seller's public response to this review"
    },
    "seller_reply_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "rated_user_id",
    "rater_user_id",
    "score"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.rater_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.rater_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}