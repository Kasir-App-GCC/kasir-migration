{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick attribute tags selected by the seller, relevant to the item's category"
    },
    "specs": {
      "type": "object",
      "description": "Structured per-category attributes (e.g. car year/make/mileage, real-estate beds/area, electronics brand/model)"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "excellent",
        "good",
        "fair",
        "poor"
      ],
      "default": "good"
    },
    "city": {
      "type": "string"
    },
    "location_name": {
      "type": "string",
      "description": "Accurate reverse-geocoded place name for display"
    },
    "country": {
      "type": "string",
      "default": "SA"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "seller_trusted": {
      "type": "boolean",
      "default": false,
      "description": "Denormalized copy of the seller's is_trusted flag, kept in sync on trust changes so the 'verified only' search filter can run server-side without joining the User collection"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "sold"
      ],
      "default": "available"
    },
    "sold_to": {
      "type": "string"
    },
    "sold_to_name": {
      "type": "string"
    },
    "is_family": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featured_until": {
      "type": "string",
      "format": "date-time"
    },
    "featured_cross_country": {
      "type": "boolean",
      "default": false
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "favorites_count": {
      "type": "number",
      "default": 0,
      "description": "Best-effort count of users who saved this listing (incremented on favorite)"
    },
    "willing_to_ship": {
      "type": "boolean",
      "default": false,
      "description": "Seller is willing to ship the item (not just face-to-face)"
    },
    "shipping_fee": {
      "type": "number",
      "description": "Shipping fee in the item's currency (used when willing_to_ship is true)"
    },
    "delivers_within_city": {
      "type": "boolean",
      "default": false,
      "description": "Seller offers delivery within the buyer's city"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Auto-set when the listing hasn't been refreshed in N days; excluded from public feeds until the seller refreshes it"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "approved",
      "description": "Admin moderation status. Real estate listings start as 'pending' (Saudi REGA license requirement) and are hidden from public feeds until approved. All other categories default to 'approved'."
    },
    "review_reason": {
      "type": "string",
      "description": "Admin's rejection reason when review_status is 'rejected'"
    },
    "re_license_type": {
      "type": "string",
      "enum": [
        "individual_fal",
        "establishment_fal",
        "ad_license"
      ],
      "description": "Type of REGA license attached to a real estate listing (FAL individual, FAL establishment, or advertisement license)"
    },
    "re_license_number": {
      "type": "string",
      "description": "REGA license number for real estate listings"
    },
    "re_license_doc": {
      "type": "string",
      "description": "URL of the uploaded license document (image or PDF) for real estate listings"
    }
  },
  "required": [
    "title",
    "price",
    "category",
    "city"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}