{
  "name": "ChatRoom",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "item_title": {
      "type": "string"
    },
    "item_image": {
      "type": "string"
    },
    "item_price": {
      "type": "number"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_avatar": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "buyer_last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "seller_last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "hidden_for_buyer": {
      "type": "boolean",
      "default": false
    },
    "hidden_for_seller": {
      "type": "boolean",
      "default": false
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "True for Management/Support official chats with users"
    },
    "official_label": {
      "type": "string",
      "description": "Display label for official chats: 'Management' or 'Support'"
    },
    "official_admin_id": {
      "type": "string",
      "description": "The admin user ID who initiated this official chat"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "item_id",
    "seller_id",
    "buyer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}